{
  "name": "dsh-session-cost-plus",
  "version": "0.2.2",
  "description": "DSH web GUI plugin: real-time current-session cost line under the stats strip (official DeepSeek pricing), plus cache-hit percentage with 2 decimals and no stats-line truncation",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "dsh-session-cost-plus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANOKO1122/dsh-session-cost-plus.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "client",
    "cost",
    "token",
    "billing",
    "pricing",
    "cache-hit"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-alpha.1",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
